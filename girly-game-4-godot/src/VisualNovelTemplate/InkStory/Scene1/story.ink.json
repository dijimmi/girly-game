_hide","exArgs":2},"pop","/ev","\n",{"->":"start4"},null],"start4":["ev","str","^fashion_club","/str",{"x()":"background","exArgs":1},"pop","/ev","\n","ev","str","^Aoi","/str",true,{"x()":"show_or_hide","exArgs":2},"pop","/ev","\n","^Aoi (Happy): It was so nice meeting other people that are into J-fashion~ it's only our first day and I've already learned so many things! ","#","^id:9f","/#","\n","^main_character: うそつき! I'm sure you knew all that already. ","#","^id:a0","/#","\n","^Aoi (Smug): Oh, so that word you do know? ","#","^id:a1","/#","\n","^main_character: I know some… ","#","^id:a2","/#","\n","^Aoi (Smile): Anyways, I'm going to talk to the President about something, I'll catch you outside. ","#","^id:a3","/#","\n","^main_character: Alright, bye bye","\n","ev","str","^Aoi","/str",false,{"x()":"show_or_hide","exArgs":2},"pop","/ev","\n","ev","str","^Ayumi","/str",{"VAR?":"CENTER"},{"x()":"move","exArgs":2},"pop","/ev","\n","ev","str","^Ayumi","/str",true,{"x()":"show_or_hide","exArgs":2},"pop","/ev","\n","ev","str","^Ayumi","/str","str","^imouto1","/str",{"x()":"speak","exArgs":2},"pop","/ev","\n","^Ayumi (Confused): いもうと なの? ","#","^id:a5","/#","\n","^main_character: Uhh, if you're asking if she's my sister, no, she's my best friend. ","#","^id:a6","/#","\n","^Ayumi (Smile): Ah I see! ","#","^id:a7","/#","\n","^Ayumi (Laugh): You do seem like good friends, haha. ","#","^id:a8","/#","\n","ev","str","^Ayumi","/str","str","^Neutral","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^main_character: Yeah, we are. ","#","^id:a9","/#","\n","^main_character: We're pretty different though. She's crazy over fashion, while I'm… ","#","^id:aa","/#","\n","^*cough* *cough* ","#","^id:ab","/#","\n","^main_character: Still learning- ","#","^id:ac","/#","\n","^Ayumi (Confused): そう... ","#","^id:ad","/#","\n","ev","str","^Ayumi","/str","str","^Neutral","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^main_character: You surely know more than me though... ","#","^id:ae","/#","\n","^Ayumi (Confused): I don't know, I've always seen kawaii-fashion and knew it existed, but it's when I tried it on that something felt like it just clicked. ","#","^id:af","/#","\n","^Ayumi (Confused): I've bought a few pieces, but I'm no expert. ","#","^id:b0","/#","\n","ev","str","^Ayumi","/str","str","^Neutral","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^main_character: I'm sure your outfits look great! ","#","^id:b1","/#","\n","ev","str","^Ayumi","/str","str","^pulse","/str",{"x()":"animate","exArgs":2},"pop","/ev","\n","ev","str","^Ayumi","/str","str","^arigatou1","/str",{"x()":"speak","exArgs":2},"pop","/ev","\n","^Ayumi (Smile): Arigatou~","\n","^Ayumi (Neutral): Ah, the President needs to lock the room, we should go, it was nice to meet you! ","#","^id:b3","/#","\n","^main_character: Wait… ","#","^id:b4","/#","\n","ev","str","^Ayumi","/str","str","^pulse","/str",{"x()":"animate","exArgs":2},"pop","/ev","\n","ev","str","^Ayumi","/str","str","^eeh1","/str",{"x()":"speak","exArgs":2},"pop","/ev","\n","^Ayumi (Worried): Eh? ","#","^id:b5","/#","\n","^main_character: I was wondering… ","#","^id:b6","/#","\n","^main_character: Since we're both learning. ","#","^id:b7","/#","\n","^main_character: What if I help you get accessories for your next outfit? ","#","^id:b8","/#","\n","^main_character: Just so I can learn a bit more, you know? ","#","^id:b9","/#","\n","^main_character: Go easy on me though. ","#","^id:ba","/#","\n","ev","str","^Ayumi","/str","str","^pulse","/str",{"x()":"animate","exArgs":2},"pop","/ev","\n","^Ayumi (Worried): ええ? ","#","^id:bb","/#","\n","^Ayumi (Worried): なに? ","#","^id:bc","/#","\n","^Ayumi (Confused): You want choose my next oufit? ","#","^id:bd","/#","\n","ev","str","^Ayumi","/str","str","^Worried","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^main_character: No no, not choose, just pick out an accessory for you. ","#","^id:be","/#","\n","^main_character: I just want to practice Japanese a bit- ","#","^id:bf","/#","\n","^main_character: So you just have to send me a website and I'll check it out! ","#","^id:c0","/#","\n","ev","str","^Ayumi","/str","str","^Neutral","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^Ayumi (Confused): そう... ","#","^id:c1","/#","\n","^Ayumi (Confused): I... ","#","^id:c2","/#","\n","^Ayumi (Smile): I think I'm okay with that! ","#","^id:c3","/#","\n","^Ayumi (Neutral): I'll give you my number just in case. ","#","^id:c4","/#","\n","^main_character: ありがとう. ","#","^id:c5","/#","\n","^main_character: I'll send you the link when I choose it. ","#","^id:c6","/#","\n","ev","str","^Ayumi","/str","str","^pulse","/str",{"x()":"animate","exArgs":2},"pop","/ev","\n","^Ayumi (Happy): うん、まかせて! ","#","^id:c7","/#","\n","^Ayumi (Smile): See you later! ","#","^id:c8","/#","\n","ev","str","^Ayumi","/str",false,{"x()":"show_or_hide","exArgs":2},"pop","/ev","\n",{"->":"start5"},null],"start5":["ev","str","^river_afternoon","/str",{"x()":"background","exArgs":1},"pop","/ev","\n","ev","str","^reunion","/str",{"x()":"play_music","exArgs":1},"pop","/ev","\n","ev","str","^President","/str",{"VAR?":"CENTER"},{"x()":"move","exArgs":2},"pop","/ev","\n","ev","str","^President","/str",true,{"x()":"show_or_hide","exArgs":2},"pop","/ev","\n","^President (Happy): Hello everyone! こんにちは! ","#","^id:ca","/#","\n","^main_character: Hello! ","#","^id:cb","/#","\n","ev","str","^President","/str","str","^Confused","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^President (Confused): is Aoi not coming to the meetup, ","ev",{"VAR?":"PlayerName"},"out","/ev","^? ","#","^id:cc","/#","\n","^main_character: I'm not sure, I thought she was already here. ","#","^id:cd","/#","\n","ev","str","^President","/str","str","^Neutral","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^President (Neutral): Sou~ ","#","^id:ce","/#","\n","^President (Neutral): Maybe she's running late. ","#","^id:cf","/#","\n","^main_character: Possibly. ","#","^id:d0","/#","\n","ev","str","^President","/str",false,{"x()":"show_or_hide","exArgs":2},"pop","/ev","\n","^I wonder... where is Ayumi? ","#","^id:d1","/#","\n","ev","str","^fullart1","/str",{"x()":"background","exArgs":1},"pop","/ev","\n","ev","str","^date","/str",{"x()":"play_music","exArgs":1},"pop","/ev","\n","^Ayumi: ","ev",{"VAR?":"PlayerName"},"out","/ev","^! ","#","^id:d3","/#","\n","^main_character: Ayumi! ","#","^id:d4","/#","\n","^Taking a look at her outfit, I feel my cheeks burning. ","#","^id:d5","/#","\n","^I was not expecting her to look so pretty… ","#","^id:d6","/#","\n","^At least Aoi isn't here. ","#","^id:d7","/#","\n","^I wouldn't want her to see me like this, how embarrassing. ","#","^id:d8","/#","\n","^Ayumi (Smile): こんにちは, げんき です か? ","#","^id:d9","/#","\n","^main_character: げんき です! ","#","^id:da","/#","\n","^main_character: あなた は かわいい です! ","#","^id:db","/#","\n","ev","str","^Ayumi","/str","str","^pulse","/str",{"x()":"animate","exArgs":2},"pop","/ev","\n","^Ayumi (Happy): ありがとう! ","#","^id:dc","/#","\n","^Ayumi (Smile): What you bought fit me very well, thank you so much! ","#","^id:dd","/#","\n","^main_character: No problem! It helped me learn some Japanese so I don't mind. ","#","^id:de","/#","\n","ev","str","^Ayumi","/str","str","^Confused","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^Ayumi (Confused): ほんと? ","#","^id:df","/#","\n","^main_character: うん! ","#","^id:e0","/#","\n","^main_character: ロリータ ファッション は、かわいい です ","#","^id:e1","/#","\n","^main_character: I think I said it right. ","#","^id:e2","/#","\n","ev","str","^Ayumi","/str","str","^Smile","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^Ayumi (Smile): はい ","#","^id:e3","/#","\n","ev","str","^fullart1_w_aoi","/str",{"x()":"background","exArgs":1},"pop","/ev","\n","ev","str","^Aoi","/str","str","^sugoi","/str",{"x()":"speak","exArgs":2},"pop","/ev","\n","ev","str","^Aoi","/str","str","^pulse","/str",{"x()":"animate","exArgs":2},"pop","/ev","\n","^Aoi (Smile): すごい! ","#","^id:e4","/#","\n","^Aoi (Happy): You look so pretty! ","#","^id:e5","/#","\n","^Ayumi (Happy): Aoi! ","#","^id:e6","/#","\n","^Ayumi (Smile): ありがとう~ ","#","^id:e7","/#","\n","^main_character: Hey, Aoi, I'm glad you made it! ","#","^id:e8","/#","\n","^Aoi (Happy): I did! ","#","^id:e9","/#","\n","^Aoi (Smile): I lost track of time and almost didn't make it, but I did. ","#","^id:ea","/#","\n","^Ayumi (Happy): I'm glad you made it too, Aoi! ","#","^id:eb","/#","\n","^Ayumi (Smile): Let's have a great time! ","#","^id:ec","/#","\n","ev","str","^black","/str",{"x()":"background","exArgs":1},"pop","/ev","\n","^After a few group activities, the presdent says their goodbyes and the other members leave as well. ","#","^id:ee","/#","\n","ev","str","^river_evening","/str",{"x()":"background","exArgs":1},"pop","/ev","\n","^Ayumi (Happy): きょう は たのしかった！ ","#","^id:ef","/#","\n","^main_character: Yeah, definitely! ","#","^id:f0","/#","\n","^main_character: It's cool to learn about Japanese culture. ","#","^id:f1","/#","\n","^main_character: And also listen to you guys talk in Japanese even though I don't understand half of it, haha. ","#","^id:f2","/#","\n","ev","str","^Ayumi","/str","str","^Laugh","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^Ayumi (Laugh): www ","#","^id:f3","/#","\n","ev","str","^Ayumi","/str","str","^Smile","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^Ayumi (Smile): You'll get there one day, keep practicing! ","#","^id:f4","/#","\n","^main_character: I will, I will... ","#","^id:f5","/#","\n","^main_character: Actually, I was thinking, if you had the time... ","#","^id:f6","/#","\n","^main_character: Could help me practice my japanese skills? ","#","^id:f7","/#","\n","ev","str","^Ayumi","/str","str","^Confused","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^Ayumi (Confused): How so? ","#","^id:f8","/#","\n","^main_character: Well, I don't know, talk to me about yourself, but in Japanese and I'll try to figure out what you're saying. ","#","^id:f9","/#","\n","ev","str","^Ayumi","/str","str","^Smile","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^Ayumi (Smile): Hmm okay! ","#","^id:fa","/#","\n","^Ayumi (Smile): Let's start easy then. ","#","^id:fb","/#","\n","^Ayumi (Happy): ファッション, うたう, だんす　そして　アニメ　を　みる　が　すき　です. ","#","^id:103","/#","\n","^main_character: Anime? You like anime? ","#","^id:104","/#","\n","ev","str","^Ayumi","/str","str","^pulse","/str",{"x()":"animate","exArgs":2},"pop","/ev","\n","^Ayumi (Happy): はい！! ","#","^id:105","/#","\n","^main_character: I love anime too, I'm such a fan of shonen like Jujustu Kaisen, Black Clover, One Punch Man… ","#","^id:106","/#","\n","^main_character: They're really cool, you should watch them. ","#","^id:107","/#","\n","^main_character: My friend Aoi watched them with me but she says it's not her type. ","#","^id:108","/#","\n","ev","str","^Ayumi","/str","str","^Confused","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^Ayumi (Confused): I'll have to agree with her, unfortunately. ","#","^id:109","/#","\n","ev","str","^Ayumi","/str","str","^Smile","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^Ayumi (Smile): I'm more into romance or slice of life animes. ","#","^id:10a","/#","\n","^main_character: Ah that's fair. ","#","^id:10b","/#","\n","^main_character: You said you sing too? ","#","^id:10c","/#","\n","ev","str","^Ayumi","/str","str","^pulse","/str",{"x()":"animate","exArgs":2},"pop","/ev","\n","^Ayumi (Excited): YES! Oh maybe your Japanese is not so bad after all. ","#","^id:10d","/#","\n","^main_character: Maybe I've been studying… ","#","^id:10e","/#","\n","^main_character: But hear me out, if you can sing, my favorite anime's intro… ","#","^id:10f","/#","\n","^main_character: We can be friends. ","#","^id:110","/#","\n","^Ayumi (Confused): Which anime would that be? ","#","^id:111","/#","\n","^main_character: Probably One Punch Man? ","#","^id:112","/#","\n","ev","str","^Ayumi","/str","str","^Smile","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^Ayumi (Smile): I mean… ","#","^id:113","/#","\n","^Ayumi (Smile): It can't be that hard… ","#","^id:114","/#","\n","ev","str","^Ayumi","/str","str","^zoom_in","/str",{"x()":"animate","exArgs":2},"pop","/ev","\n","^Ayumi (Excited): One PUUUUUUUUUUNCH ","#","^id:115","/#","\n","ev","str","^Ayumi","/str","str","^reset_zoom","/str",{"x()":"animate","exArgs":2},"pop","/ev","\n","^main_character: Haha, you nailed it. ","#","^id:116","/#","\n","^main_character: I declare us, officialy, friends. ","#","^id:117","/#","\n","ev","str","^Ayumi","/str","str","^Laugh","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^Ayumi (Laugh): www ","#","^id:118","/#","\n","^main_character: No, but what do you usually like to sing? ","#","^id:119","/#","\n","ev","str","^Ayumi","/str","str","^Confused","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^Ayumi (Confused): Umm… ","#","^id:11a","/#","\n","^Ayumi (Confused): I haven't sung in a while, actually… ","#","^id:11b","/#","\n","^main_character: Oh, really. May I ask why? ","#","^id:11c","/#","\n","^Ayumi (Sad): It's a long story… ","#","^id:11d","/#","\n","^Ayumi (Sad): I don't want to get into it right now. ","#","^id:11e","/#","\n","^main_character: Oh, ごめん！ ","#","^id:11f","/#","\n","ev","str","^Ayumi","/str","str","^Smile","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^Ayumi (Smile): Don't worry! ","#","^id:120","/#","\n","ev","str","^Ayumi","/str","str","^Neutral","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^The two of you stay quiet for a few seconds. ","#","^id:121","/#","\n","^main_character: Everyone already left… ","#","^id:122","/#","\n","^Ayumi (Neutral): Yeah, they did a while ago. ","#","^id:123","/#","\n","ev","str","^Ayumi","/str","str","^Smile","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^Ayumi (Smile): But it's fun talking with you, ","ev",{"VAR?":"PlayerName"},"out","/ev","^ ","#","^id:124","/#","\n","^main_character: Likewise. ","#","^id:125","/#","\n","^main_character: So, since I chose your accessory correctly this time. ","#","^id:131","/#","\n","^main_character: Would you like some help choosing your next outfit? ","#","^id:132","/#","\n","ev","str","^Ayumi","/str","str","^Confused","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","ev","str","^Ayumi","/str","str","^pulse","/str",{"x()":"animate","exArgs":2},"pop","/ev","\n","^Ayumi (Confused): ええ? ","#","^id:133","/#","\n","^Ayumi (Confused): ほんと? ","#","^id:134","/#","\n","^I nod. ","#","^id:135","/#","\n","^Ayumi (Neutral): Mmm, let me think. ","#","^id:136","/#","\n","ev","str","^Ayumi","/str","str","^Smile","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^Ayumi (Smile): I would love to! ","#","^id:137","/#","\n","^Ayumi (Smile): I'm probably going to use the same dress, so ","#","^id:138","/#","\n","^Ayumi (Happy): Find me another headpiece that goes with it! ","#","^id:139","/#","\n","^Ayumi (Happy): Should have pastel colors, and I want it to be small, okay?","\n","^main_character: I think I already have something in mind. ","#","^id:13a","/#","\n","ev","str","^Ayumi","/str","str","^Mischevious","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^Ayumi (Mischevious): Great! If you have any questions you can text me too ;) ","#","^id:13b","/#","\n","^main_character: Pfft, im an expert already, come on. ","#","^id:13c","/#","\n","ev","str","^Ayumi","/str","str","^Laugh","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^Ayumi (Laugh): www ","#","^id:13d","/#","\n","ev","str","^Ayumi","/str","str","^Smile","/str",{"x()":"change_expression","exArgs":2},"pop","/ev","\n","^Ayumi (Smile): Alright then, I'll see you next week! ","#","^id:13e","/#","\n","^main_character: See ya! ","#","^id:13f","/#","\n","ev","str","^Ayumi","/str",false,{"x()":"show_or_hide","exArgs":2},"pop","/ev","\n","end",null],"global decl":["ev",0,{"VAR=":"LEFTEST"},1,{"VAR=":"LEFT"},2,{"VAR=":"CENTER"},3,{"VAR=":"RIGHT"},4,{"VAR=":"RIGHTEST"},"str","^Aoi","/str",{"VAR=":"FriendName"},"str","^Frank Castle","/str",{"VAR=":"PlayerName"},0.0,{"VAR=":"LEVEL"},"/ev","end",null]}],"listDefs":{}}